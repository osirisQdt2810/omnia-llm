[Unit]
Description=Public HTTPS entry to the omnia-llm gateway (ngrok, outbound only)
After=network-online.target omnia-llm.service
Wants=omnia-llm.service

[Service]
Type=simple
# Outbound connection to ngrok; nothing on this machine listens publicly. --log=stdout so the
# journal holds it. The gateway still requires a token on every route but /health.
EnvironmentFile=%h/workspaces/omnia-llm/deploy/ngrok.env
ExecStart=%h/workspaces/omnia-llm/bin/ngrok http 127.0.0.1:8721 --url=${NGROK_URL} --log=stdout --log-format=logfmt
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
