[Unit]
Description=omnia-llm gateway (lazy vLLM on one free GPU)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/workspaces/omnia-llm
ExecStart=%h/workspaces/omnia-llm/run.sh
Restart=on-failure
RestartSec=5
# The gateway itself holds no GPU; only the engine it spawns does, and that one is reaped on
# idle. Killing the whole control group on stop is what stops a restart leaking a held card.
KillMode=control-group
TimeoutStopSec=60

[Install]
WantedBy=default.target
